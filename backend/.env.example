MARKETLENS_APP_NAME="MarketLens AI API"
MARKETLENS_ENVIRONMENT="development"
MARKETLENS_CORS_ORIGINS='["http://localhost:5173"]'
MARKETLENS_BSE_API_BASE_URL="https://api.bseindia.com/BseIndiaAPI/api"
MARKETLENS_BSE_SITE_BASE_URL="https://www.bseindia.com"
MARKETLENS_BSE_ATTACHMENT_BASE_URL="https://www.bseindia.com/xml-data/corpfiling/AttachLive/"
