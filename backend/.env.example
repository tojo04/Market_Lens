MARKETLENS_HTTP_CONNECT_TIMEOUT_SECONDS=5
MARKETLENS_HTTP_READ_TIMEOUT_SECONDS=15
MARKETLENS_HTTP_WRITE_TIMEOUT_SECONDS=15
MARKETLENS_HTTP_POOL_TIMEOUT_SECONDS=5
MARKETLENS_PROVIDER_MAX_RESULTS=20
MARKETLENS_MAX_DOWNLOAD_BYTES=15728640
MARKETLENS_MAX_PDF_PAGES=100
MARKETLENS_MAX_REDIRECTS=3
MARKETLENS_MARKET_DATA_TIMEOUT_SECONDS=15
MARKETLENS_MARKET_EVENT_WINDOW_DAYS=7
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-sol"
